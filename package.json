{
  "name": "turnoya",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run db:generate -w backend && npm run build -w frontend",
    "start": "npm run start -w frontend",
    "lint": "eslint",
    "test": "npm test -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "postinstall": "npm run db:generate -w backend",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:reset": "npm run db:reset -w backend",
    "db:studio": "npm run db:studio -w backend",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "docker:prod": "docker compose --profile prod up -d --build",
    "test:int": "npm run test:int -w backend",
    "test:todo": "npm test && npm run test:int",
    "db:test:prepare": "npm run db:test:prepare -w backend",
    "db:seed:historico": "npm run db:seed:historico -w backend"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260901.1": true,
    "@prisma/engines@7.10.0": true
  }
}
