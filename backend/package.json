{
  "name": "@turnoya/backend",
  "version": "0.2.0",
  "private": true,
  "description": "Lógica de servidor de TurnoYa: reglas, servicios, acceso a datos (Prisma), migraciones y pruebas",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:int": "tsx --test --test-concurrency=1 tests/integracion/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:test:prepare": "node scripts/bd-pruebas.mjs",
    "db:seed:historico": "tsx prisma/seed-historico.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
