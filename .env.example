# ---------------------------------------------------------------------------
# TurnoYa — variables de entorno (copia a .env y ajusta). Las leen el proyecto Java (backend/) y legacy/.
# Sin comillas: Spring Boot importa este archivo como propiedades y dotenv (legacy/) también lo entiende así.
# ---------------------------------------------------------------------------

# Base de datos (docker compose up -d db)
DATABASE_URL=postgresql://turnoya:turnoya@localhost:5432/turnoya?schema=public
# Solo para las pruebas de integración de legacy/ (npm run db:test:prepare && npm run test:int)
TEST_DATABASE_URL=postgresql://turnoya:turnoya@localhost:5432/turnoya_test?schema=public

# Seguridad (F7): en producción la app NO arranca con valores vacíos, de ejemplo o de menos de 32 caracteres.
# Genera valores con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-64-caracteres-hex-aleatorios
DATA_ENCRYPTION_KEY=cambia-esto-por-64-caracteres-hex-aleatorios
# ALLOW_INSECURE_SECRETS=true   # solo para demos locales en modo producción

# URL pública (enlaces de seguimiento y QR). Java: APP_URL (puerto 8080). legacy/: NEXT_PUBLIC_APP_URL (3000).
APP_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tareas programadas (F1). false en réplicas que solo atienden web, o en pruebas.
ENABLE_JOBS=true
LOG_LEVEL=info
# Token para leer /api/metrics sin sesión (Prometheus) — legacy/
METRICS_TOKEN=

# Tiempo real (Java): memoria (una instancia) | redis (varias réplicas; requiere REDIS_URL)
TURNOYA_BUS=memoria
REDIS_URL=redis://localhost:6379

# WhatsApp: mock | openwa | meta
WHATSAPP_PROVIDER=mock
# OpenWA (gateway auto-hospedado)
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION=turnoya
OPENWA_WEBHOOK_SECRET=
OPENWA_WEBHOOK_BASE_URL=http://host.docker.internal:3000
# Meta Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=turnoya-verify
# M4: mensajes entrantes máximos por teléfono y minuto
BOT_MAX_MSG_MIN=20

# Correo (M7 reportes, alertas de nivel 3). Sin SMTP los reportes quedan para descarga.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TurnoYa <no-responder@turnoya.pe>
REPORTE_EMAIL=
REPORTES_DIR=./.reportes

# M5: horas máximas que un ticket offline puede tardar en sincronizar antes de ir a revisión
KIOSCO_VENTANA_OFFLINE_H=12

# Pagos con Mercado Pago (Checkout API / Card Payment Brick). Credenciales de prueba en developers.mercadopago.com
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones → Webhooks). Vacía = no se verifica la firma (solo desarrollo)
MERCADOPAGO_WEBHOOK_SECRET=
# Solo desarrollo: no llama a /v1/payments; el titular de la tarjeta de prueba decide el resultado (APRO, CONT, OTHE, FUND, SECU…)
MERCADOPAGO_SIMULADO=
